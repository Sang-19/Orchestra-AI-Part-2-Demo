# LLM_PROVIDER: Choose "gemini" (default) or "ollama" for local self-hosted inference.
LLM_PROVIDER="gemini"

# GEMINI_API_KEY: Required when LLM_PROVIDER="gemini" for Gemini reasoning & embeddings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OLLAMA CONFIGURATION. Gemini can remain the text provider while Ollama handles embeddings.
EMBEDDING_PROVIDER="ollama"
# Used when LLM_PROVIDER="ollama" or EMBEDDING_PROVIDER="ollama":
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Per-agent Gemini model selections are managed in Workspace Settings.
# Optional environment overrides: GEMINI_MODEL_PLANNER, GEMINI_MODEL_WRITER, etc.

# TAVILY_API_KEY: Optional external web search engine key for Tavily research.
# When omitted, Orchestra AI falls back to Gemini Google Search Grounding.
TAVILY_API_KEY=""

# JWT_SECRET: Signing key for authentication session cookies/tokens.
JWT_SECRET="replace-with-strong-random-secret"

# DATABASE_PATH: SQLite persistence file path (defaults to ./data/orchestra.db).
DATABASE_PATH="./data/orchestra.db"

# ALLOWED_ORIGINS: Comma-separated CORS origins for production deployment.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:5173"

# Maximum time allowed for a single structured AI agent request (default: 90 seconds).
AGENT_REQUEST_TIMEOUT_MS=90000
