# LLM_PROVIDER: Choose "gemini" (default) or "ollama" for local self-hosted inference.
LLM_PROVIDER="gemini"

# GEMINI_API_KEY: Required when LLM_PROVIDER="gemini" for Gemini reasoning & embeddings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OLLAMA CONFIGURATION (used when LLM_PROVIDER="ollama" on local / Docker self-hosting):
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# TAVILY_API_KEY: Optional external web search engine key for Tavily research.
# When omitted, Orchestra AI falls back to Gemini Google Search Grounding.
TAVILY_API_KEY=""

# JWT_SECRET: Signing key for authentication session cookies/tokens.
JWT_SECRET="replace-with-strong-random-secret"

# DATABASE_PATH: SQLite persistence file path (defaults to ./data/orchestra.db).
DATABASE_PATH="./data/orchestra.db"

# ALLOWED_ORIGINS: Comma-separated CORS origins for production deployment.
ALLOWED_ORIGINS="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
